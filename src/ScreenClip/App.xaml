<Application x:Class="ScreenClip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <!-- No ThemeMode here: the Fluent theme is only loaded when a window or the menu first opens (App.EnsureTheme),
       so that the app, resident in the notification area, stays light until then. -->
  <Application.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The app's colors (icon gradient), kept in both themes. -->
    <Color x:Key="BrandStartColor">#7B61FF</Color>
    <Color x:Key="BrandEndColor">#E5489A</Color>

    <!-- Line icons of the capture actions, drawn on a 16 px grid (same drawings as the mock-up). -->
    <Geometry x:Key="IconArea">M2,5 V3.5 A1.5,1.5 0 0 1 3.5,2 H5 M11,2 H12.5 A1.5,1.5 0 0 1 14,3.5 V5 M14,11 V12.5 A1.5,1.5 0 0 1 12.5,14 H11 M5,14 H3.5 A1.5,1.5 0 0 1 2,12.5 V11</Geometry>
    <Geometry x:Key="IconWindow">M2.5,3 H13.5 A1,1 0 0 1 14.5,4 V12 A1,1 0 0 1 13.5,13 H2.5 A1,1 0 0 1 1.5,12 V4 A1,1 0 0 1 2.5,3 Z M1.5,6 H14.5</Geometry>
    <Geometry x:Key="IconScreen">M2.5,2.5 H13.5 A1,1 0 0 1 14.5,3.5 V10.5 A1,1 0 0 1 13.5,11.5 H2.5 A1,1 0 0 1 1.5,10.5 V3.5 A1,1 0 0 1 2.5,2.5 Z M5.5,14 H10.5 M8,11.5 V14</Geometry>
    <Geometry x:Key="IconAllScreens">M1.5,3.5 H7 V9.5 H1.5 Z M9,3.5 H14.5 V9.5 H9 Z M3,12 H5.5 M10.5,12 H13</Geometry>
    <Geometry x:Key="IconRepeat">M13.5,8 A5.5,5.5 0 1 1 11.6,3.8 M13.5,2 V5 H10.5</Geometry>
    <Geometry x:Key="IconCamera">M1.5,5.5 A1,1 0 0 1 2.5,4.5 H4.5 L6,2.5 H10 L11.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V12.5 A1,1 0 0 1 13.5,13.5 H2.5 A1,1 0 0 1 1.5,12.5 Z M8,6.5 A2.5,2.5 0 1 0 8,11.5 A2.5,2.5 0 1 0 8,6.5 Z</Geometry>
    <Geometry x:Key="IconVideo">M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 Z</Geometry>
    <Geometry x:Key="IconFolder">M1.5,4.5 V12.5 A1,1 0 0 0 2.5,13.5 H13.5 A1,1 0 0 0 14.5,12.5 V6 A1,1 0 0 0 13.5,5 H8 L6.5,3 H2.5 A1,1 0 0 0 1.5,4.5 Z</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A card, like the rows of the Windows 11 Settings app. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- A card that needs attention (a shortcut Windows refuses). -->
    <Style x:Key="WarningCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    </Style>

    <!-- Rows under the first one of a card, aligned with its title (16 padding + 20 icon + 16 margin). -->
    <Style x:Key="CardSubRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="52,12,16,12" />
    </Style>

    <Style x:Key="CardDivider" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,16,0,8" />
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A key of a shortcut, drawn like a keyboard key. -->
    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Message bar, like the InfoBar of WinUI: informational (accent) or warning (caution). -->
    <Style x:Key="InfoBar" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="WarningBar" TargetType="Border" BasedOn="{StaticResource InfoBar}">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    </Style>

    <Style x:Key="SuccessBar" TargetType="Border" BasedOn="{StaticResource InfoBar}">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>

    <!-- Windows 11 toggle switch: the Fluent theme has its brushes but no style for it. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}">
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
