<Window x:Class="ScreenClip.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenClip"
        Title="ScreenClip"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Width="1" Height="1"
        Background="Black" Cursor="Cross" UseLayoutRounding="True">

  <Window.Resources>
    <!-- A mode of the capture bar: Area, Window, Screen. -->
    <Style x:Key="ModeButton" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Mode" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" CornerRadius="4" Padding="12,0" Height="36" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <!-- The accent for a picture, red for a video (CaptureOverlay.ModeChanged sets both). -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ModeCheckedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ModeCheckedTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Picture or video, first in the bar (asked by the author: a toggle after the modes was not clear): the one
         chosen in the accent, or red for a video, as recording is everywhere. -->
    <Style x:Key="KindButton" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Kind" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border CornerRadius="4" Padding="12,0" Height="32" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="VideoKindButton" TargetType="RadioButton" BasedOn="{StaticResource KindButton}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The sound of a video: struck through when off. -->
    <Style x:Key="AudioToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Back" CornerRadius="4" MinWidth="36" Height="36" Padding="8,0" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On: the accent, as a chosen mode; off is the usual way (the pointer filmed), not a sound turned off. -->
    <Style x:Key="PointerToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Back" CornerRadius="4" Width="36" Height="36" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BarIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Labels drawn over the screen: dark in both themes, like those of Windows' own capture tool. -->
    <SolidColorBrush x:Key="LabelBackground" Color="#DC1C1C20" />

    <Style x:Key="BarDivider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="Transparent">
    <!-- The screen as it was when the shortcut was pressed, pixel for pixel. -->
    <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

    <!-- Dims everything but the hole (the area, window or screen chosen). -->
    <Path x:Name="Shade" Fill="#73000000" IsHitTestVisible="False" />

    <Canvas x:Name="Marks" IsHitTestVisible="False">
      <Rectangle x:Name="CrossH" Height="1" Fill="#99FFFFFF" Visibility="Collapsed" />
      <Rectangle x:Name="CrossV" Width="1" Fill="#99FFFFFF" Visibility="Collapsed" />
      <Rectangle x:Name="Outline" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" Visibility="Collapsed" />
      <Border x:Name="SizeLabel" CornerRadius="4" Background="{StaticResource LabelBackground}" Padding="8,3" Visibility="Collapsed">
        <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
      </Border>
      <StackPanel x:Name="Magnifier" Visibility="Collapsed">
        <Grid Width="120" Height="120">
          <Ellipse Stroke="White" StrokeThickness="2" RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Ellipse.Fill>
              <ImageBrush x:Name="LensBrush" ViewboxUnits="Absolute" Stretch="Fill" />
            </Ellipse.Fill>
            <Ellipse.Effect>
              <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" />
            </Ellipse.Effect>
          </Ellipse>
          <Rectangle Width="10" Height="10" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
        </Grid>
        <Border CornerRadius="4" Background="{StaticResource LabelBackground}" Padding="8,2" Margin="0,6,0,0"
                HorizontalAlignment="Center">
          <TextBlock x:Name="LensText" Foreground="White" FontSize="11" />
        </Border>
      </StackPanel>
    </Canvas>

    <!-- Capture bar: what to capture, the video to come, cancel. -->
    <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="6"
            CornerRadius="8" Cursor="Arrow" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.3" Direction="270" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Border CornerRadius="6" Padding="2" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ImageKindButton" Style="{StaticResource KindButton}" Checked="Kind_Checked"
                         ToolTip="{local:Tr ImageModeToolTip}" AutomationProperties.Name="{local:Tr ModeImage}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconCamera}" />
                <TextBlock Text="{local:Tr ModeImage}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="VideoKindButton" Style="{StaticResource VideoKindButton}" Checked="Kind_Checked"
                         ToolTip="{local:Tr VideoModeToolTip}" AutomationProperties.Name="{local:Tr ModeVideo}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconVideo}" />
                <TextBlock Text="{local:Tr ModeVideo}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <Rectangle Style="{StaticResource BarDivider}" />
        <RadioButton x:Name="AreaButton" Style="{StaticResource ModeButton}" Checked="Mode_Checked"
                     AutomationProperties.Name="{local:Tr ModeArea}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconArea}" />
            <TextBlock Text="{local:Tr ModeArea}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="WindowButton" Style="{StaticResource ModeButton}" Checked="Mode_Checked"
                     AutomationProperties.Name="{local:Tr ModeWindow}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconWindow}" />
            <TextBlock Text="{local:Tr ModeWindow}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ScreenButton" Style="{StaticResource ModeButton}" Checked="Mode_Checked"
                     AutomationProperties.Name="{local:Tr ModeScreen}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconScreen}" />
            <TextBlock Text="{local:Tr ModeScreen}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <!-- “All screens” (a picture, with several screens only) and a video's sounds and pointer share one place, as
             wide as the wider of them, the other hidden in it: the bar keeps its width from one kind to the other, so
             that no button moves under the mouse (asked by the author). -->
        <Grid>
        <RadioButton x:Name="AllScreensButton" Style="{StaticResource ModeButton}" Checked="Mode_Checked" HorizontalAlignment="Left"
                     AutomationProperties.Name="{local:Tr ModeAllScreens}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource BarIcon}" Data="{StaticResource IconAllScreens}" />
            <TextBlock Text="{local:Tr ModeAllScreens}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <StackPanel x:Name="AudioOptions" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Hidden">
          <Rectangle Style="{StaticResource BarDivider}" />
          <!-- Each sound with its meter (step 3 of the video: to see that the microphone hears before recording). -->
          <ToggleButton x:Name="SystemSoundButton" Style="{StaticResource AudioToggle}" Checked="Audio_Changed" Unchecked="Audio_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SystemSoundGlyph" Style="{StaticResource IconText}" FontSize="15" />
              <Border x:Name="SystemSoundMeter" Width="4" Height="16" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                      Background="{DynamicResource ControlStrongFillColorDisabledBrush}" Visibility="Hidden">
                <Border x:Name="SystemSoundLevel" Height="0" VerticalAlignment="Bottom" CornerRadius="2" Background="#1D9E75" />
              </Border>
            </StackPanel>
          </ToggleButton>
          <!-- A right click chooses the microphone (asked by the author: nothing more to see on the bar). -->
          <ToggleButton x:Name="MicrophoneButton" Style="{StaticResource AudioToggle}" Checked="Audio_Changed" Unchecked="Audio_Changed"
                        MouseRightButtonUp="Microphone_MouseRightButtonUp">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="MicrophoneGlyph" Style="{StaticResource IconText}" FontSize="15" />
              <Border x:Name="MicrophoneMeter" Width="4" Height="16" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                      Background="{DynamicResource ControlStrongFillColorDisabledBrush}" Visibility="Hidden">
                <Border x:Name="MicrophoneLevel" Height="0" VerticalAlignment="Bottom" CornerRadius="2" Background="#1D9E75" />
              </Border>
            </StackPanel>
          </ToggleButton>
          <!-- The pointer filmed with the screen (the video is ready at once), or recorded apart to be restyled in the
               editor (asked by the author: both ways). -->
          <ToggleButton x:Name="PointerButton" Style="{StaticResource PointerToggle}" Checked="Audio_Changed" Unchecked="Audio_Changed">
            <Grid Width="20" Height="20">
              <Path x:Name="PointerGlyph" Width="18" Height="18" Stretch="None" StrokeThickness="1.4" StrokeLineJoin="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Data="M5,2.5 V14.5 L8,11.6 L10,16.2 L12.2,15.2 L10.2,10.8 H14.4 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
              <!-- Apart: a little pen, it will be drawn again. -->
              <Path x:Name="PointerPen" Width="10" Height="10" Stretch="None" StrokeThickness="1.3" StrokeLineJoin="Round"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-1"
                    Data="M1.5,8.5 L2,6.5 L6.5,2 L8,3.5 L3.5,8 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </Grid>
          </ToggleButton>
        </StackPanel>
        </Grid>
        <Rectangle Style="{StaticResource BarDivider}" />
        <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="Cancel_Click"
                ToolTip="{local:Tr CancelCapture}" AutomationProperties.Name="{local:Tr CancelCapture}">
          <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE711;" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Keys that help, at the bottom. -->
    <Border x:Name="Hints" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,72" Padding="14,8"
            CornerRadius="8" Background="{StaticResource LabelBackground}" IsHitTestVisible="False">
      <StackPanel x:Name="HintsPanel" Orientation="Horizontal" TextElement.Foreground="#F2F2F2" TextElement.FontSize="12" />
    </Border>
  </Grid>
</Window>
