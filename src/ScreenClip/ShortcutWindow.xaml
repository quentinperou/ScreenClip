<Window x:Class="ScreenClip.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenClip"
        Title="{local:Tr ShortcutChangeTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <StackPanel Margin="24,20,24,24">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap" />

    <!-- The keys pressed, drawn as keys. -->
    <Border Margin="0,16,0,0" Height="64" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid>
        <TextBlock x:Name="Placeholder" Text="{local:Tr ShortcutPressKeys}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ItemsControl x:Name="Keys" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Keycap}" Padding="12,4">
                <TextBlock Text="{Binding}" FontSize="16" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <TextBlock x:Name="Problem" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

    <DockPanel Margin="0,24,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="{local:Tr ShortcutNone}" Click="None_Click" Focusable="False" />
      <Button DockPanel.Dock="Right" Content="{local:Tr Cancel}" IsCancel="True" MinWidth="96" Focusable="False" />
      <Button x:Name="OkButton" DockPanel.Dock="Right" Content="{local:Tr Ok}" Style="{DynamicResource AccentButtonStyle}"
              MinWidth="96" Margin="0,0,8,0" IsEnabled="False" Click="Ok_Click" Focusable="False" />
    </DockPanel>
  </StackPanel>
</Window>
