<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection, for the video capture (Windows.Graphics.Capture: borderless capture needs the
         22621 SDK). Its assembly is only loaded when a video is recorded. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>ScreenClip</AssemblyName>
    <RootNamespace>ScreenClip</RootNamespace>
    <ApplicationIcon>Assets\ScreenClip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ScreenClip</Product>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Application.ThemeMode (Windows 11 Fluent theme) is still marked experimental in WPF .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- The app stays in the notification area all day: as light as it can be. No background GC thread (the heap
         is small and the app idle), and code compiled ahead of time (less JIT memory, a first capture without
         waiting for the JIT). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Frames copied between Media Foundation buffers and SkiaSharp without extra copies. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ScreenClip.ico" />
    <Resource Include="Assets\ScreenClip.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects do not import System.IO implicitly. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenClip.Core\ScreenClip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Video: Direct3D 11 for the frames, Media Foundation to encode and decode H.264 / AAC (Vortice, MIT), WASAPI
         for the sound of the computer and the microphone (NAudio, MIT; 2.2.1, the long-used one). Loaded only when a
         video is recorded or opened. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
