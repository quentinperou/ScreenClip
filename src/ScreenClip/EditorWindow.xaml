<Window x:Class="ScreenClip.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenClip"
        Title="ScreenClip"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/ScreenClip.ico"
        AllowDrop="True" UseLayoutRounding="True">

  <Window.Resources>
    <!-- A choice of a segmented control (frame theme, tilt, ratio, file format). -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" CornerRadius="4" Height="28" Margin="1" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"
                                TextElement.FontSize="13" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentBar" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
    </Style>

    <!-- A swatch, a frame or a preset: a tile with a ring when chosen. -->
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="2">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The last preset tile: saves the current style under a name. -->
    <Style x:Key="AddTile" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="2" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,12,14,14" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="104" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style x:Key="BarLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The two tabs, Edit and Layout, in the middle of the command bar. -->
    <Style x:Key="TabSegment" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" CornerRadius="5" Height="30" MinWidth="148" Margin="1" Padding="16,0" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A tool of the column on the left (Edit tab). -->
    <Style x:Key="ToolButton" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" Width="36" Height="34" CornerRadius="5" Margin="0,1" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Width="36" Height="34" CornerRadius="5" Margin="0,1" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The zoom of the Edit tab, at the bottom right of the picture. -->
    <Style x:Key="ZoomButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Height="28" CornerRadius="4" Padding="7,0" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="12" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A color of the annotations: a disc, ringed when chosen. -->
    <Style x:Key="ColorSwatch" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Ring" Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" Padding="2">
              <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A row of the list of annotations. -->
    <Style x:Key="ListRow" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" Height="32" CornerRadius="5" Padding="8,0" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The text of an annotation while it is typed: no box of its own, the annotation's look is set from code. -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Command bar: capture and import on the left, the two tabs in the middle, save and copy on the right. In a
         narrow window, the buttons show their icons alone (FitCommandBar). -->
    <Grid x:Name="CommandBar" Margin="12,8,12,8" SizeChanged="CommandBar_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="LeftCommands" Orientation="Horizontal" HorizontalAlignment="Left">
      <Button x:Name="NewCaptureButton" Style="{StaticResource BarButton}" Click="NewCapture_Click"
              AutomationProperties.Name="{local:Tr EditorNewCapture}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArea}" />
          <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr EditorNewCapture}" />
          <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="8,1,0,0" Text="&#xE70D;" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource BarButton}" Click="Import_Click" ToolTip="Ctrl+O"
              AutomationProperties.Name="{local:Tr EditorImport}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE8E5;" />
          <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr EditorImport}" />
        </StackPanel>
      </Button>
      <!-- A picture animated (asked by the author): a length and a timeline, for a pointer that moves on it; checked
           while it is. -->
      <ToggleButton x:Name="AnimateButton" Margin="0,0,6,0" Padding="12,5" Click="Animate_Click" Visibility="Collapsed"
                    ToolTip="{local:Tr AnimateToolTip}" AutomationProperties.Name="{local:Tr Animate}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE7C9;" />
          <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr Animate}" />
        </StackPanel>
      </ToggleButton>

      </StackPanel>

      <!-- Edit (the tools, on the capture alone) and Layout (background, frame, shadow): proposal B of the mock-up,
           chosen by the author. Both export the same picture. -->
      <Border x:Name="TabBar" Grid.Column="1" Style="{StaticResource SegmentBar}" CornerRadius="7" Margin="12,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="EditTab" Style="{StaticResource TabSegment}" GroupName="EditorTab" Checked="Tab_Checked"
                       ToolTip="Ctrl+1" AutomationProperties.Name="{local:Tr TabEdit}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE70F;" />
              <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr TabEdit}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="LayoutTab" Style="{StaticResource TabSegment}" GroupName="EditorTab" Checked="Tab_Checked"
                       ToolTip="Ctrl+2" AutomationProperties.Name="{local:Tr TabLayout}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE790;" />
              <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr TabLayout}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- Right to left: Settings at the far right (as in Crop PDF), then Copy (the main action), then Save. -->
      <StackPanel x:Name="RightCommands" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <!-- Export (asked by the author, in place of Save): a small window with the format, whether the layout is applied,
           and Copy or Save. Its format shows on it (the mock-up's “Save · MP4”). -->
      <Button x:Name="ExportButton" Style="{StaticResource BarButton}" Click="ExportButton_Click" ToolTip="{local:Tr ExportToolTip}"
              AutomationProperties.Name="{local:Tr Export}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE74E;" />
          <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr Export}" />
          <TextBlock x:Name="SaveFormat" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE70D;" Margin="6,1,0,0" />
        </StackPanel>
      </Button>
      <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Bottom" StaysOpen="False"
             AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="2">
        <Border Margin="8" Padding="18,16" Width="320" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Direction="270" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="{local:Tr Export}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <!-- What it gives, small: with the layout or without (asked by the author). -->
            <Border CornerRadius="6" Height="150" Margin="0,0,0,14" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
              <Image x:Name="ExportPreview" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="{local:Tr ExportFormat}" FontSize="13" Margin="0,0,0,6" />
            <Border Style="{StaticResource SegmentBar}">
              <UniformGrid x:Name="ExportFormatList" Rows="1" />
            </Border>
            <TextBlock x:Name="ExportFormatHint" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <DockPanel Margin="0,14,0,0">
              <CheckBox x:Name="ExportLayoutSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                        Checked="ExportLayout_Changed" Unchecked="ExportLayout_Changed" AutomationProperties.Name="{local:Tr ExportLayout}" />
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{local:Tr ExportLayout}" FontSize="13" />
                <TextBlock x:Name="ExportLayoutHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="ExportSize" FontSize="12" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button x:Name="ExportCopyButton" Content="{local:Tr Copy}" Margin="0,0,8,0" Padding="14,5" Click="ExportCopy_Click" />
              <Button Style="{DynamicResource AccentButtonStyle}" Content="{local:Tr ExportSave}" Padding="14,5" Click="ExportSave_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>
      <!-- What it copies on it too (asked by the author: “Copy as PNG”): always a picture, in the format of the settings. -->
      <Button x:Name="CopyButton" Style="{DynamicResource AccentButtonStyle}" Padding="14,5"
              Click="Copy_Click" ToolTip="Ctrl+C" AutomationProperties.Name="{local:Tr Copy}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE8C8;" />
          <TextBlock x:Name="CopyText" Style="{StaticResource BarLabel}" Text="{local:Tr Copy}" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource BarButton}" Margin="10,0,0,0" Padding="8,5" Background="Transparent"
              BorderThickness="0" Click="Settings_Click" ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}">
        <TextBlock Style="{StaticResource IconText}" FontSize="16" Text="&#xE713;" />
      </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="12,0,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>

      <!-- Edit tab: the tools, in a column; undo and redo at the bottom. -->
      <Border x:Name="ToolRail" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="5" Width="48" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="UndoButton" Style="{StaticResource RailButton}" Click="Undo_Click">
              <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource RailButton}" Click="Redo_Click">
              <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE7A6;" />
            </Button>
          </StackPanel>
          <StackPanel x:Name="ToolList" />
        </DockPanel>
      </Border>

      <!-- Preview. -->
      <Border x:Name="PreviewArea" Grid.Column="1" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="PreviewHost" Margin="24,24,24,8" SizeChanged="PreviewHost_SizeChanged" PreviewMouseWheel="PreviewHost_PreviewMouseWheel">
            <!-- The picture, and over it what the Edit tab shows while drawing (handles, crop frame, the text typed). -->
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                  MouseDown="Stage_MouseDown" MouseUp="Stage_MouseUp" LostMouseCapture="Stage_LostMouseCapture"
                  MouseRightButtonUp="Stage_MouseRightButtonUp"
                  MouseLeave="Stage_MouseLeave">
              <Image x:Name="Preview" Stretch="Fill" Cursor="Hand" RenderOptions.BitmapScalingMode="HighQuality"
                     MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" />
              <Canvas x:Name="Overlay" IsHitTestVisible="False" />
              <Canvas x:Name="TextLayer" />
            </Grid>
            <!-- Zoomed in, the picture moves under the window: these, the wheel, or the middle button. -->
            <ScrollBar x:Name="HScroll" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed" Scroll="ViewScroll_Scroll" />
            <ScrollBar x:Name="VScroll" Orientation="Vertical" HorizontalAlignment="Right" Visibility="Collapsed" Scroll="ViewScroll_Scroll" />

            <!-- Nothing to lay out yet. -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
              <!-- The app's own icon (scripts\make-icons.ps1). -->
              <Image Source="Assets/ScreenClip.png" Width="80" Height="80" HorizontalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality" />

              <TextBlock Text="{local:Tr EditorEmptyTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{local:Tr EditorEmptyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <!-- Capturing first (asked by the author): the editor opened by hand is mostly seen by people who do not
                     know the shortcut yet; a picture they already have can also be pasted or dropped. -->
                <Button Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0" Click="CaptureArea_Click"
                        AutomationProperties.Name="{local:Tr CaptureArea}">
                  <StackPanel Orientation="Horizontal">
                    <!-- The color of the button's text, dark on the accent color. -->
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArea}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr CaptureArea}" />
                  </StackPanel>
                </Button>
                <!-- A video, straight in video mode (asked by the author). -->
                <Button Padding="16,6" Margin="0,0,8,0" Click="RecordVideo_Click" AutomationProperties.Name="{local:Tr CaptureVideo}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconVideo}" />
                    <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr CaptureVideo}" />
                  </StackPanel>
                </Button>
                <Button Padding="16,6" Click="Import_Click" AutomationProperties.Name="{local:Tr EditorImport}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE8E5;" />
                    <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr EditorImport}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- A file was written (Save, or the capture saved automatically): one line at the top right of the picture (the
               author's choice: the card of issue #1 at the bottom left covered the picture and the timeline), to open it
               or show it in its folder; it goes after a few seconds, unless the mouse is on it. -->
          <Grid x:Name="SavedToast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                Visibility="Collapsed" MouseEnter="SavedToast_MouseEnter" MouseLeave="SavedToast_MouseLeave">
            <!-- The shadow on a layer of its own: an effect on the card would blur its text. -->
            <Border CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="6" BorderThickness="1" Padding="10,4,4,4"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xEC61;" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="SavedToastTitle" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="13" VerticalAlignment="Center">
                  <Hyperlink Click="SavedToastOpen_Click"><Run Text="{local:Tr ToastOpen}" /></Hyperlink>
                </TextBlock>
                <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="13" VerticalAlignment="Center">
                  <Hyperlink Click="SavedToastShowInFolder_Click"><Run Text="{local:Tr ToastFolder}" /></Hyperlink>
                </TextBlock>
                <Button Width="26" Height="26" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Click="SavedToastClose_Click" ToolTip="{local:Tr Close}" AutomationProperties.Name="{local:Tr Close}">
                  <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE711;" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Size of the export, and what happened last (copied, saved). -->
          <!-- A video: play, the time, and the timeline (frames, the yellow handles that cut the start and the end,
               the playhead). -->
          <Grid x:Name="VideoBar" Grid.Row="1" Margin="16,16,16,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <!-- Room for the tracks' scroll bar, with the margin on the right. -->
              <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- A handle between the picture and the timeline (asked by the author): up gives the tracks more room, as
                 far as the picture stays seen; never smaller than at first; a double click puts it back. -->
            <Thumb x:Name="TracksHandle" Grid.ColumnSpan="4" VerticalAlignment="Top" Height="6" Margin="0,-16,0,0"
                   Cursor="SizeNS" DragDelta="TracksHandle_DragDelta" MouseDoubleClick="TracksHandle_MouseDoubleClick"
                   ToolTip="{local:Tr TracksHandleToolTip}">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent">
                    <Border x:Name="Grip" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource ControlStrongFillColorDefaultBrush}" Opacity="0.6" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Grip" Property="Opacity" Value="1" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
            <Button x:Name="PlayButton" Style="{DynamicResource AccentButtonStyle}" Width="40" Height="34" Padding="0"
                    VerticalAlignment="Center" Click="Play_Click">
              <TextBlock x:Name="PlayGlyph" Style="{StaticResource IconText}" FontSize="14" Text="&#xE768;" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,14,0" VerticalAlignment="Center">
              <TextBlock x:Name="VideoTimeText" VerticalAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular" />
              <!-- An animation's length, in seconds (or its end pulled on the timeline). -->
              <StackPanel x:Name="AnimationLengthPanel" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed">
                <TextBox x:Name="AnimationLengthBox" Width="52" MinWidth="0" FontSize="12" Padding="6,4" TextAlignment="Right"
                         KeyDown="AnimationLength_KeyDown" LostFocus="AnimationLength_LostFocus"
                         ToolTip="{local:Tr AnimationLengthToolTip}" AutomationProperties.Name="{local:Tr AnimationLength}" />
                <TextBlock Text="{local:Tr SecondsShort}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <Grid x:Name="Timeline" Grid.Column="2" Height="58" Margin="0,-10,0,0" Background="Transparent" Cursor="Hand" ClipToBounds="False"
                  MouseLeftButtonDown="Timeline_MouseLeftButtonDown" MouseMove="Timeline_MouseMove"
                  MouseLeftButtonUp="Timeline_MouseLeftButtonUp" SizeChanged="Timeline_SizeChanged" MouseRightButtonUp="Timeline_MouseRightButtonUp">
              <Border x:Name="FilmStrip" Margin="0,16,0,6" CornerRadius="4" ClipToBounds="True"
                      Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                <Image x:Name="ThumbStrip" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
              <Canvas x:Name="TimelineMarks" IsHitTestVisible="False" />
            </Grid>
            <!-- A track per annotation (and the recorded pointer), under the frames: its bar is when it shows; drag it,
                 or its ends; the diamonds of an A → B pointer are when it leaves and arrives. The scroll bar stands apart
                 on the right, in its own column and the margin (over the bars, it hid their ends: the author); the
                 tracks keep the timeline's left edge and width, so that a time is at the same place on both. -->
            <ScrollViewer x:Name="TrackScroll" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4,-12,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
              <Canvas x:Name="TrackCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" ClipToBounds="True"
                      MouseLeftButtonDown="TrackCanvas_MouseLeftButtonDown" MouseMove="TrackCanvas_MouseMove"
                      MouseLeftButtonUp="TrackCanvas_MouseLeftButtonUp" LostMouseCapture="TrackCanvas_LostMouseCapture"
                      MouseRightButtonUp="TrackCanvas_MouseRightButtonUp" />
            </ScrollViewer>
            <!-- The pieces (step 3 of the video): split at the playhead, remove the piece there or put it back. -->
            <StackPanel x:Name="PieceButtons" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
              <Button x:Name="SplitButton" Style="{StaticResource ZoomButton}" Click="Split_Click" ToolTip="{local:Tr SplitToolTip}"
                      AutomationProperties.Name="{local:Tr SplitToolTip}">
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE8C6;" />
              </Button>
              <Button x:Name="RemovePieceButton" Style="{StaticResource ZoomButton}" Margin="4,0,0,0" Click="RemovePiece_Click"
                      ToolTip="{local:Tr RemovePieceToolTip}" AutomationProperties.Name="{local:Tr RemovePieceToolTip}">
                <TextBlock x:Name="RemovePieceGlyph" Style="{StaticResource IconText}" FontSize="14" Text="&#xE74D;" />
              </Button>
            </StackPanel>
            <!-- The sounds: a row each (the computer and the microphone apart, or the one sound), its label on the left. -->
            <StackPanel x:Name="SoundLabels" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="Collapsed" />
            <Canvas x:Name="SoundCanvas" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" Margin="0,6,0,0" Background="Transparent"
                    Visibility="Collapsed" MouseLeftButtonDown="SoundCanvas_MouseLeftButtonDown" MouseMove="SoundCanvas_MouseMove"
                    MouseLeftButtonUp="SoundCanvas_MouseLeftButtonUp" LostMouseCapture="SoundCanvas_LostMouseCapture"
                    MouseRightButtonUp="SoundCanvas_MouseRightButtonUp" />
          </Grid>

          <DockPanel Grid.Row="2" Margin="16,0,16,10" LastChildFill="False">
            <TextBlock x:Name="OutputText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed" />
            <StackPanel x:Name="ZoomBar" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-4,0,-4">
              <Button x:Name="ZoomOutButton" Style="{StaticResource ZoomButton}" Click="ZoomOut_Click" ToolTip="{local:Tr ZoomOut}"
                      AutomationProperties.Name="{local:Tr ZoomOut}">
                <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE71F;" />
              </Button>
              <Button x:Name="ZoomActualButton" Style="{StaticResource ZoomButton}" MinWidth="54" Click="ZoomActual_Click"
                      ToolTip="{local:Tr ZoomActual}" AutomationProperties.Name="{local:Tr ZoomActual}">
                <TextBlock x:Name="ZoomText" />
              </Button>
              <Button x:Name="ZoomInButton" Style="{StaticResource ZoomButton}" Click="ZoomIn_Click" ToolTip="{local:Tr ZoomIn}"
                      AutomationProperties.Name="{local:Tr ZoomIn}">
                <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE8A3;" />
              </Button>
              <Button x:Name="ZoomFitButton" Style="{StaticResource ZoomButton}" Margin="6,0,0,0" Click="ZoomFit_Click"
                      ToolTip="{local:Tr ZoomFitToolTip}" AutomationProperties.Name="{local:Tr ZoomFit}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE9A6;" />
                  <TextBlock Text="{local:Tr ZoomFit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock x:Name="DragHint" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{local:Tr EditorDragHint}" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Settings of the layout. -->
      <!-- The scroll bar in a lane of its own, not against the cards (asked by the author). -->
      <ScrollViewer x:Name="LayoutPanel" Grid.Column="3" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
        <StackPanel x:Name="Panel">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <DockPanel>
                <!-- A small button, not a link (asked by the author): it changes the style. -->
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                        Padding="10,3" FontSize="12" Click="Reset_Click" AutomationProperties.Name="{local:Tr EditorReset}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Text="&#xE7A7;" />
                    <TextBlock Text="{local:Tr EditorReset}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr EditorStyles}" />
              </DockPanel>
              <UniformGrid x:Name="PresetList" Columns="4" />

              <!-- The name of a preset, asked when saving or renaming one, under its tile. -->
              <Popup x:Name="PresetNamePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                     PopupAnimation="Fade">
                <Border Margin="8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Direction="270" />
                  </Border.Effect>
                  <StackPanel Width="260">
                    <TextBlock FontWeight="SemiBold" Text="{local:Tr PresetName}" />
                    <TextBox x:Name="PresetNameBox" Margin="0,10,0,0" MaxLength="40"
                             TextChanged="PresetNameBox_TextChanged" KeyDown="PresetNameBox_KeyDown"
                             AutomationProperties.Name="{local:Tr PresetName}" />
                    <TextBlock x:Name="PresetNameTaken" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{local:Tr PresetNameTaken}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                      <Button x:Name="PresetNameOk" Style="{DynamicResource AccentButtonStyle}" MinWidth="96"
                              Content="{local:Tr Save}" Click="PresetNameOk_Click" />
                      <Button MinWidth="96" Margin="8,0,0,0" Content="{local:Tr Cancel}" Click="PresetNameCancel_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr EditorBackground}" />
              <UniformGrid x:Name="BackgroundList" Columns="7" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr EditorFrame}" />
              <UniformGrid x:Name="FrameList" Columns="3" />
              <!-- Only for a frame: hidden with “None”; the text only for the windows (not the devices). -->
              <StackPanel x:Name="FrameOptions">
              <DockPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr EditorFrameTheme}" />
                <Border Style="{StaticResource SegmentBar}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="LightFrame" Style="{StaticResource Segment}" GroupName="FrameTheme" Content="{local:Tr ThemeLight}" Checked="Option_Changed" />
                    <RadioButton x:Name="DarkFrame" Style="{StaticResource Segment}" GroupName="FrameTheme" Content="{local:Tr ThemeDark}" Checked="Option_Changed" />
                  </UniformGrid>
                </Border>
              </DockPanel>
              <DockPanel x:Name="FrameTextRow" Margin="0,10,0,0">
                <TextBlock x:Name="FrameTextLabel" Style="{StaticResource RowLabel}" Text="{local:Tr EditorAddress}" />
                <TextBox x:Name="FrameTextBox" TextChanged="FrameTextBox_TextChanged" />
              </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr EditorLayout}" />
              <DockPanel>
                <TextBlock Text="{local:Tr EditorPadding}" FontSize="13" />
                <TextBlock x:Name="PaddingValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DockPanel>
              <Slider x:Name="PaddingSlider" Minimum="0" Maximum="25" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                      TickFrequency="1" ValueChanged="Slider_ValueChanged" Margin="0,2,0,8"
                      AutomationProperties.Name="{local:Tr EditorPadding}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                      ToolTip="{local:Tr SliderResetToolTip}" />
              <!-- The corners of a window: a device has its own. -->
              <StackPanel x:Name="RadiusRow">
                <DockPanel>
                  <TextBlock Text="{local:Tr EditorCorners}" FontSize="13" />
                  <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="80" SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True"
                        TickFrequency="1" ValueChanged="Slider_ValueChanged" Margin="0,2,0,8"
                        AutomationProperties.Name="{local:Tr EditorCorners}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                      ToolTip="{local:Tr SliderResetToolTip}" />
              </StackPanel>
              <DockPanel>
                <TextBlock Text="{local:Tr EditorShadow}" FontSize="13" />
                <TextBlock x:Name="ShadowValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DockPanel>
              <Slider x:Name="ShadowSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"
                      TickFrequency="5" ValueChanged="Slider_ValueChanged" Margin="0,2,0,10"
                      AutomationProperties.Name="{local:Tr EditorShadow}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                      ToolTip="{local:Tr SliderResetToolTip}" />
              <DockPanel>
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr EditorTilt}" />
                <Border Style="{StaticResource SegmentBar}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="TiltLeft" Style="{StaticResource Segment}" GroupName="Tilt" Content="{local:Tr TiltLeft}" Checked="Tilt_Checked" />
                    <RadioButton x:Name="TiltNone" Style="{StaticResource Segment}" GroupName="Tilt" Content="{local:Tr TiltNone}" Checked="Tilt_Checked" />
                    <RadioButton x:Name="TiltRight" Style="{StaticResource Segment}" GroupName="Tilt" Content="{local:Tr TiltRight}" Checked="Tilt_Checked" />
                  </UniformGrid>
                </Border>
              </DockPanel>
              <!-- The turn by hand; a double click on a slider puts it back to 0. -->
              <DockPanel Margin="0,10,0,0">
                <TextBlock Text="{local:Tr EditorTurn}" FontSize="13" />
                <TextBlock x:Name="TurnValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DockPanel>
              <Slider x:Name="TurnSlider" Minimum="-30" Maximum="30" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                      TickFrequency="1" ValueChanged="Slider_ValueChanged" MouseDoubleClick="AngleSlider_MouseDoubleClick"
                      Margin="0,2,0,8" AutomationProperties.Name="{local:Tr EditorTurn}" ToolTip="{local:Tr EditorAngleReset}" />
              <DockPanel>
                <TextBlock Text="{local:Tr EditorTiltVertical}" FontSize="13" />
                <TextBlock x:Name="TiltValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DockPanel>
              <Slider x:Name="TiltSlider" Minimum="-20" Maximum="20" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                      TickFrequency="1" ValueChanged="Slider_ValueChanged" MouseDoubleClick="AngleSlider_MouseDoubleClick"
                      Margin="0,2,0,0" AutomationProperties.Name="{local:Tr EditorTiltVertical}" ToolTip="{local:Tr EditorAngleReset}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr EditorFormat}" />
              <Border Style="{StaticResource SegmentBar}">
                <UniformGrid x:Name="RatioList" Rows="1" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Edit tab: the options of the tool (or of the annotation chosen), then the annotations of the picture. -->
      <ScrollViewer x:Name="EditPanel" Grid.Column="3" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
        <StackPanel>
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Border x:Name="ToolKeyCap" DockPanel.Dock="Right" Style="{StaticResource Keycap}" Margin="0" Padding="7,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ToolKey" FontSize="12" />
                </Border>
                <ContentControl x:Name="ToolIcon" VerticalAlignment="Center" Focusable="False"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ToolName" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
              </DockPanel>

              <StackPanel x:Name="ColorRow" Margin="0,0,0,12">
                <TextBlock Text="{local:Tr AnnotColor}" FontSize="13" Margin="0,0,0,6" />
                <WrapPanel x:Name="ColorList" />
              </StackPanel>
              <DockPanel x:Name="SizeRow" Margin="0,0,0,10">
                <TextBlock x:Name="SizeLabel" Style="{StaticResource RowLabel}" Width="84" />
                <Border Style="{StaticResource SegmentBar}">
                  <UniformGrid x:Name="SizeList" Rows="1" />
                </Border>
              </DockPanel>
              <DockPanel x:Name="StyleRow" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource RowLabel}" Width="84" Text="{local:Tr AnnotStyle}" />
                <Border Style="{StaticResource SegmentBar}">
                  <UniformGrid x:Name="StyleList" Rows="1" />
                </Border>
              </DockPanel>

              <StackPanel x:Name="PointerRow">
                <UniformGrid x:Name="PointerList" Columns="3" Margin="0,0,0,12" />
                <DockPanel>
                  <TextBlock Text="{local:Tr AnnotSize}" FontSize="13" />
                  <TextBlock x:Name="PointerSizeValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="PointerSizeSlider" Minimum="24" Maximum="160" SmallChange="4" LargeChange="16" TickFrequency="4"
                        IsSnapToTickEnabled="True" ValueChanged="PointerSize_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr AnnotSize}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                      ToolTip="{local:Tr SliderResetToolTip}" />
                <DockPanel x:Name="HaloRow" Margin="0,0,0,10">
                  <CheckBox x:Name="HaloSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                            Checked="Halo_Changed" Unchecked="Halo_Changed" AutomationProperties.Name="{local:Tr AnnotHalo}" />
                  <TextBlock Text="{local:Tr AnnotHalo}" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
                <!-- In a video: the pointer goes from A to B (the mock-up's animated pointer). -->
                <StackPanel x:Name="MotionRow">
                  <DockPanel Margin="0,0,0,10">
                    <CheckBox x:Name="MotionSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                              Checked="Motion_Changed" Unchecked="Motion_Changed" AutomationProperties.Name="{local:Tr AnnotMotion}" />
                    <TextBlock Text="{local:Tr AnnotMotion}" FontSize="13" VerticalAlignment="Center" />
                  </DockPanel>
                  <StackPanel x:Name="MotionOptions">
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Style="{StaticResource RowLabel}" Width="84" Text="{local:Tr MotionPath}" />
                      <Border Style="{StaticResource SegmentBar}">
                        <UniformGrid x:Name="MotionPathList" Rows="1" />
                      </Border>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Style="{StaticResource RowLabel}" Width="84" Text="{local:Tr MotionPace}" />
                      <Border Style="{StaticResource SegmentBar}">
                        <UniformGrid x:Name="MotionPaceList" Rows="1" />
                      </Border>
                    </DockPanel>
                    <TextBlock Text="{local:Tr MotionClick}" FontSize="13" Margin="0,0,0,6" />
                    <Border Style="{StaticResource SegmentBar}" Margin="0,0,0,10">
                      <UniformGrid x:Name="MotionClickList" Rows="1" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- The pointer recorded with the video: how it is drawn. -->
              <StackPanel x:Name="RecordedPointerRow">
                <UniformGrid x:Name="RecordedStyleList" Columns="3" Margin="0,0,0,12" />
                <DockPanel>
                  <TextBlock Text="{local:Tr AnnotSize}" FontSize="13" />
                  <TextBlock x:Name="RecordedSizeValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="RecordedSizeSlider" Minimum="50" Maximum="400" SmallChange="10" LargeChange="50" TickFrequency="10"
                        IsSnapToTickEnabled="True" ValueChanged="RecordedSize_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr AnnotSize}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                      ToolTip="{local:Tr SliderResetToolTip}" />
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Style="{StaticResource RowLabel}" Width="84" Text="{local:Tr RecordedMovement}" />
                  <Border Style="{StaticResource SegmentBar}">
                    <UniformGrid x:Name="RecordedMovementList" Rows="1" />
                  </Border>
                </DockPanel>
                <TextBlock Text="{local:Tr RecordedClicks}" FontSize="13" Margin="0,0,0,6" />
                <Border Style="{StaticResource SegmentBar}" Margin="0,0,0,10">
                  <UniformGrid x:Name="RecordedClickList" Rows="1" />
                </Border>
              </StackPanel>

              <!-- A sound of a video chosen (step 3 of the video): its volume, its fades, muted or not. -->
              <StackPanel x:Name="SoundRow">
                <DockPanel>
                  <TextBlock Text="{local:Tr SoundVolume}" FontSize="13" />
                  <TextBlock x:Name="SoundVolumeValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="SoundVolume_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr SoundVolume}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                        ToolTip="{local:Tr SliderResetToolTip}" />
                <DockPanel>
                  <TextBlock Text="{local:Tr SoundFadeIn}" FontSize="13" />
                  <TextBlock x:Name="SoundFadeInValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="SoundFadeInSlider" Minimum="0" Maximum="5" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" ValueChanged="SoundFadeIn_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr SoundFadeIn}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                        ToolTip="{local:Tr SliderResetToolTip}" />
                <DockPanel>
                  <TextBlock Text="{local:Tr SoundFadeOut}" FontSize="13" />
                  <TextBlock x:Name="SoundFadeOutValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="SoundFadeOutSlider" Minimum="0" Maximum="5" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" ValueChanged="SoundFadeOut_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr SoundFadeOut}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                        ToolTip="{local:Tr SliderResetToolTip}" />
                <DockPanel Margin="0,0,0,10">
                  <CheckBox x:Name="SoundMuteSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                            Checked="SoundMute_Changed" Unchecked="SoundMute_Changed" AutomationProperties.Name="{local:Tr SoundMuted}" />
                  <TextBlock Text="{local:Tr SoundMuted}" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
                <!-- The piece of this sound clicked, silenced alone, the picture kept (asked by the author). -->
                <Button x:Name="SoundSilenceButton" Click="SoundSilence_Click" HorizontalAlignment="Left" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE74F;" />
                    <TextBlock x:Name="SoundSilenceText" Style="{StaticResource BarLabel}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- A piece of a video chosen (a click on its frames): its zoom, its frame on the picture (asked by the
                   author); the Crop tool sets the size of the whole video. -->
              <StackPanel x:Name="PieceRow">
                <DockPanel>
                  <TextBlock Text="{local:Tr PieceZoom}" FontSize="13" />
                  <TextBlock x:Name="PieceZoomValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Slider x:Name="PieceZoomSlider" Minimum="100" Maximum="400" SmallChange="5" LargeChange="25" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="PieceZoom_ValueChanged" Margin="0,2,0,10"
                        AutomationProperties.Name="{local:Tr PieceZoom}" MouseDoubleClick="SliderReset_MouseDoubleClick"
                        ToolTip="{local:Tr SliderResetToolTip}" />
                <WrapPanel Margin="0,0,0,10">
                  <Button x:Name="PieceResetButton" Click="PieceReset_Click" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE9A6;" />
                      <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr MenuResetFraming}" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="PieceRemoveButton" Click="RemovePiece_Click" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="PieceRemoveGlyph" Style="{StaticResource IconText}" FontSize="13" Text="&#xE74D;" />
                      <TextBlock x:Name="PieceRemoveText" Style="{StaticResource BarLabel}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>

              <TextBlock x:Name="NextNumberText" FontSize="13" Margin="0,0,0,10" />

              <StackPanel x:Name="CropRow" Margin="0,0,0,10">
                <TextBlock x:Name="CropText" FontSize="13" />
                <Button x:Name="CropAllButton" Content="{local:Tr CropAll}" Click="CropAll_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
              </StackPanel>

              <WrapPanel x:Name="SelectionRow" Margin="0,0,0,10">
                <Button Click="BringToFront_Click" Margin="0,0,8,0" AutomationProperties.Name="{local:Tr AnnotFront}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE746;" />
                    <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr AnnotFront}" />
                  </StackPanel>
                </Button>
                <Button Click="DeleteAnnotation_Click" AutomationProperties.Name="{local:Tr AnnotDelete}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE74D;" />
                    <TextBlock Style="{StaticResource BarLabel}" Text="{local:Tr AnnotDelete}" />
                  </StackPanel>
                </Button>
              </WrapPanel>

              <TextBlock x:Name="ToolHelp" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <DockPanel>
                <Button x:Name="ClearAllButton" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                        Padding="10,3" FontSize="12" Click="ClearAll_Click" AutomationProperties.Name="{local:Tr AnnotClearAll}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Text="&#xE894;" />
                    <TextBlock Text="{local:Tr AnnotClearAll}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PanelTitle}" Text="{local:Tr AnnotList}" />
              </DockPanel>
              <!-- Dragged up or down, an annotation goes under or over the others (the line shows where). -->
              <Grid>
                <StackPanel x:Name="AnnotationList" Background="Transparent"
                            PreviewMouseLeftButtonDown="AnnotationList_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="AnnotationList_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="AnnotationList_PreviewMouseLeftButtonUp"
                            LostMouseCapture="AnnotationList_LostMouseCapture" />
                <Canvas x:Name="AnnotationDrop" IsHitTestVisible="False" />
              </Grid>
              <TextBlock x:Name="AnnotationListEmpty" Text="{local:Tr AnnotListEmpty}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- An export under way: how far, and a way to stop it; in the middle of the window, the rest greyed (asked by
         the author: it showed at the bottom of the picture, over the video). -->
    <!-- A question or a message, in the look of Windows 11's dialogs (EditorWindow.Dialog.cs). -->
    <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="2">
      <Border MinWidth="460" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" Direction="270" />
        </Border.Effect>
        <StackPanel>
          <StackPanel Margin="24,22,24,24">
            <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="DialogText" TextWrapping="Wrap" LineHeight="20" />
          </StackPanel>
          <Border Padding="24,18" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <UniformGrid x:Name="DialogButtons" Rows="1" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="ExportOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
      <Border x:Name="ExportCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
              Padding="20,16" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Direction="270" />
        </Border.Effect>
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="ExportPercent" DockPanel.Dock="Right" FontSize="12" Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ExportTitle" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="1" Height="4" Margin="0,12,0,14" />
          <Button HorizontalAlignment="Right" Content="{local:Tr Cancel}" Click="ExportCancel_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
