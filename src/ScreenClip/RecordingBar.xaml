<Window x:Class="ScreenClip.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenClip"
        Title="ScreenClip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI">

  <Window.Resources>
    <!-- Dark in both themes, like the bars Windows shows while it records. -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Width="32" Height="30" CornerRadius="15" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="SoundButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Height="30" Padding="8,0" CornerRadius="15" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#30FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="Pill" CornerRadius="21" Background="#F21F1F22" BorderBrush="#40FFFFFF" BorderThickness="1"
          Padding="14,5,6,5" Margin="10" MouseLeftButtonDown="Pill_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Direction="270" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF4D4F" VerticalAlignment="Center" Margin="0,0,9,0" />
      <TextBlock x:Name="TimeText" Foreground="White" FontSize="13" VerticalAlignment="Center" MinWidth="44" Margin="0,0,8,0"
                 Typography.NumeralAlignment="Tabular" />
      <!-- The sounds recorded, each with its meter: a click mutes it from now on (asked by the author). -->
      <Button x:Name="ComputerButton" Style="{StaticResource SoundButton}" Click="Computer_Click" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ComputerGlyph" Style="{StaticResource Glyph}" Text="&#xE767;" />
          <Border Width="4" Height="14" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center" Background="#40FFFFFF">
            <Border x:Name="ComputerLevel" Height="0" VerticalAlignment="Bottom" CornerRadius="2" Background="#3DD68C" />
          </Border>
        </StackPanel>
      </Button>
      <Button x:Name="MicrophoneButton" Style="{StaticResource SoundButton}" Click="Microphone_Click" Margin="0,0,6,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="MicrophoneGlyph" Style="{StaticResource Glyph}" Text="&#xE720;" />
          <Border Width="4" Height="14" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center" Background="#40FFFFFF">
            <Border x:Name="MicrophoneLevel" Height="0" VerticalAlignment="Bottom" CornerRadius="2" Background="#3DD68C" />
          </Border>
        </StackPanel>
      </Button>
      <!-- During the countdown: start at once (asked by the author). -->
      <Button x:Name="StartNowButton" Style="{StaticResource PillButton}" Click="StartNow_Click">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
      </Button>
      <Button x:Name="PauseButton" Style="{StaticResource PillButton}" Click="Pause_Click">
        <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
      </Button>
      <Button x:Name="StopButton" Style="{StaticResource PillButton}" Background="#C42B1C" Margin="2,0" Click="Stop_Click">
        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="White" />
      </Button>
      <Button x:Name="RestartButton" Style="{StaticResource PillButton}" Click="Restart_Click">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
      </Button>
      <Button x:Name="DiscardButton" Style="{StaticResource PillButton}" Click="Discard_Click">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
      </Button>
    </StackPanel>
  </Border>
</Window>
