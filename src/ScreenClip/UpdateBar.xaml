<UserControl x:Class="ScreenClip.UpdateBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenClip"
             Visibility="Collapsed">
  <!-- New version available, at the top of every window: What's new, Update (installs from here), close. -->
  <Border Style="{StaticResource InfoBar}" Padding="14,6,6,6">
    <DockPanel>
      <!-- Hidden rather than disabled while installing: a disabled button gets a solid background. -->
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="8"
              Click="Close_Click" ToolTip="{local:Tr Close}" AutomationProperties.Name="{local:Tr Close}">
        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE711;" />
      </Button>
      <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,4,0">
        <Button Content="{local:Tr UpdateWhatsNew}" Margin="0,0,6,0" Click="Notes_Click" />
        <Button Content="{local:Tr UpdateInstall}" Style="{DynamicResource AccentButtonStyle}" Click="Install_Click" />
      </StackPanel>
      <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Margin="12,0,10,0" Maximum="1"
                   VerticalAlignment="Center" Visibility="Collapsed" />
      <TextBlock x:Name="Message" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Border>
</UserControl>
