<Window x:Class="ScreenClip.RecordingFrame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenClip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" IsHitTestVisible="False"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid>
    <!-- Just outside the area: the line is never in the video, and the window lets every click through. -->
    <Rectangle x:Name="Line" Stroke="#FF4D4F" StrokeThickness="2" StrokeDashArray="4 3" Margin="1" />
    <!-- 3, 2, 1 before the recording starts. -->
    <Border x:Name="Countdown" Width="120" Height="120" CornerRadius="60" Background="#C01F1F22"
            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="CountText" Foreground="White" FontSize="56" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6" />
    </Border>
  </Grid>
</Window>
